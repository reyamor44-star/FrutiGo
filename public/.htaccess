# Redirección Forzada HTTPS y Canonicalización de Dominio - Fruti Go

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Forzar HTTPS en todas las peticiones HTTP
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://frutigo.com.mx/$1 [R=301,L]

  # 2. Redirección permanente 301 de www a non-www
  RewriteCond %{HTTP_HOST} ^www\.frutigo\.com\.mx [NC]
  RewriteRule ^(.*)$ https://frutigo.com.mx/$1 [R=301,L]

  # 3. Permitir acceso directo a .well-known (Digital Asset Links)
  RewriteRule ^\.well-known/ - [L]

  # 4. Soporte para enrutamiento de Single Page Application (SPA)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
